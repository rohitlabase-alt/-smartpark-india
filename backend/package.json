{
  "name": "@smartpark/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx db/migrate.ts",
    "check:infra": "tsx scripts/check-infra.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@node-rs/argon2": "^2.2.0",
    "@smartpark/shared": "*",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "jose": "^6.2.10",
    "pg": "^8.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
