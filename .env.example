# ------------------------------------------------------------------
# SmartPark India — environment placeholders (Pune MVP, Phase 1A)
# Copy to .env and fill real values locally. NEVER commit .env.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000

# Database (placeholder — NOT required in Phase 1A. Used from Phase 2+)
DATABASE_URL=postgresql://smartpark:smartpark@localhost:5432/smartpark

# API base URL (backend self-reference / future client config)
API_BASE_URL=http://localhost:4000/api/v1

# Web app public env (browser-facing, VITE_ prefix per Vite convention)
VITE_API_BASE_URL=http://localhost:4000/api/v1