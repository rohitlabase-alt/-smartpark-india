# ------------------------------------------------------------------
# SmartPark India — environment placeholders (Pune MVP)
# Copy to .env and fill real values locally. NEVER commit .env.
#
# Infrastructure overrides below map 1:1 to docker-compose.yml.
# All values default to safe local dev values, so `npm run infra:up`
# works without a .env. Setting them here lets you change ports/creds.
# ------------------------------------------------------------------

# ----------------------------- Application -----------------------------
# NODE_ENV: development | test | production
NODE_ENV=development

# HTTP port the Express API listens on
API_PORT=4000

# Backend self-reference / future client config
API_BASE_URL=http://localhost:4000/api/v1

# Comma-separated browser origins. Leave unset for the development default;
# production must configure this explicitly.
CORS_ORIGINS=http://localhost:5173

# Web app public env (browser-facing, VITE_ prefix per Vite convention)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ----------------------------- Auth (Phase 2A) -----------------------------
# HMAC secret used to sign access-token JWTs. NEVER commit a real value; the
# API fails closed on auth operations while this is unset. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Access-token lifetime (docs/SECURITY.md §6 recommends ~30 min; "30m"/"1h"
# or plain seconds all work)
JWT_EXPIRES_IN=30m

# Refresh-token lifetime (rotated on every use, revocable)
REFRESH_TOKEN_EXPIRES_IN=30d

# ----------------------------- Database --------------------------------
# Postgres connection string for the backend (matches docker-compose defaults)
DATABASE_URL=postgresql://smartpark:smartpark@localhost:5432/smartpark

# docker-compose overrides (postgres service)
POSTGRES_USER=smartpark
POSTGRES_PASSWORD=smartpark
POSTGRES_DB=smartpark
POSTGRES_PORT=5432

# ----------------------------- Object storage ---------------------------
# S3-compatible endpoint settings (used by the storage abstraction).
# ENDPOINT has no scheme; PORT is used when creating the S3 client.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=smartpark-minio
MINIO_SECRET_KEY=smartpark-minio-secret
# Default bucket created lazily by the storage layer / init script
MINIO_BUCKET=smartpark-documents
MINIO_REGION=us-east-1
# docker-compose override (minio service console)
MINIO_CONSOLE_PORT=9001

# ----------------------------- Blockchain (dev only) --------------------
# Anvil is a dev-only local EVM chain. NEVER point these at production.
ANVIL_RPC_URL=http://localhost:8545
ANVIL_CHAIN_ID=31337
# docker-compose override (anvil service)
ANVIL_RPC_PORT=8545
